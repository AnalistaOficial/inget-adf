{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-estudos01"
		},
		"LKS_BancoSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LKS_BancoSQL'"
		},
		"LKS_DataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LKS_DataLake'"
		},
		"HttpServer1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/jbrownlee/Datasets/master/shampoo.csv"
		},
		"HttpServer2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"LKS_BancoSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "estudo-sqlserver.database.windows.net"
		},
		"LKS_BancoSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "estudo-sqldb"
		},
		"LKS_BancoSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "estudo"
		},
		"LKS_DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://estudodatalake01.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-estudos01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LKS_BancoSQL_password": {
						"value": "[parameters('LKS_BancoSQL_password')]"
					},
					"LKS_DataLake_accountKey": {
						"value": "[parameters('LKS_DataLake_accountKey')]"
					},
					"HttpServer1_properties_typeProperties_url": {
						"value": "[parameters('HttpServer1_properties_typeProperties_url')]"
					},
					"HttpServer2_properties_typeProperties_url": {
						"value": "[parameters('HttpServer2_properties_typeProperties_url')]"
					},
					"LKS_BancoSQL_properties_typeProperties_server": {
						"value": "[parameters('LKS_BancoSQL_properties_typeProperties_server')]"
					},
					"LKS_BancoSQL_properties_typeProperties_database": {
						"value": "[parameters('LKS_BancoSQL_properties_typeProperties_database')]"
					},
					"LKS_BancoSQL_properties_typeProperties_userName": {
						"value": "[parameters('LKS_BancoSQL_properties_typeProperties_userName')]"
					},
					"LKS_DataLake_properties_typeProperties_url": {
						"value": "[parameters('LKS_DataLake_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-estudos01_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-estudos01_ArmTemplate_0')]"
			]
		}
	]
}